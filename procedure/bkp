type Read struct {
	Exa *exa.Client
}

func NewRead(exa *exa.Client) Read {
	return &Read{Exa: exa}
}

func (r *Read) Schema() map[string]any {
	return map[string]any{
		"name":        "read",
		"description": "Read the contents of a local or remote resource. Supports UTF-8 text, directories, PDFs, and images (JPEG, PNG, WebP).",
		"parameters": map[string]any{
			"type": "object",
			"properties": map[string]any{
				"resource": map[string]any{
					"type":        "string",
					"description": "Local filesystem path or URL to read. Ex.: \"README.md\", \"./\", \"Área de Trabalho/Cotação de Março.pdf\", \"https://example.com\".",
				},
				"offset": map[string]any{
					"type":        "number",
					"description": "For text, byte offset to start reading; defaults to 0. For directories, entry offset to start listing; defaults to 0. For PDFs, page to read; defaults to 1.",
				},
			},
			"required": []string{"resource"},
		},
	}
}

func (r *Read) Call(args map[string]any) any {
	var resource string
	var offset int64 = 0
	resourceArg, ok := args["resource"]
	if !ok {
		return "invalid arguments: missing resource"
	}
	resource, ok = resourceArg.(string)
	if !ok {
		return "invalid arguments: resource is not a string"
	}
	offsetArg, ok := args["offset"]
	if ok {
		offset, ok = offsetArg.(int)
		if !ok {
			return "invalid arguments: offset is not a number"
		}
	}
	if strings.HasPrefix(resource, "http://") || strings.HasPrefix(resource, "https://") {
		return r.remote(resource, offset)
	} else {
		return r.local(resource, offset)
	}
}

func (r *Read) remote(resource string, offset int64) any {
	resp, err := http.Head(resource)
	if err != nil {
		return fmt.Sprintf("HEAD: %s", err)
	}
	defer resp.Body.Close()
	var mediaType string
	if resp.StatusCode == 200 {
		mediaType = resp.Header.Get("Content-Type")
	}
	if mimetype.EqualsAny(mediaType, "application/pdf", "image/jpeg", "image/png", "image/webp") {
		resp, err := http.Get(resource)
		if err != nil {
			return fmt.Sprintf("GET: %s", err)
		}
		defer resp.Body.Close()
		if resp.Status != 200 {
			return fmt.Sprintf("GET: %d %s", resp.StatusCode, http.StatusText(resp.StatusCode))
		}
		content, err := io.ReadAll(resp.Body)
		if err != nil {
			return fmt.Sprintf("read response body: %s", err)
		}
		if mimetype.EqualsAny(mediaType, "application/pdf") {
			return pdf(content, offset)
		} else {
			return image(content, mediaType)
		}
	} else {
		content, err := r.Exa.Fetch(resource)
		if err != nil {
			return fmt.Sprintf("fetch resource: %s", err)
		}
		return text(content, offset)
	}
}

func (r *Read) local(resource string, offset int64) any {
	for _, e := range strings.Split(filepath.ToSlash(filePath.Clean(resource)), "/") {
		if e == "." || e == ".." {
			continue
		}
		if strings.HasPrefix(e, ".") {
			return fmt.Sprintf("invalid arguments: resource not found")
		}
	}
	if !filepath.IsLocal(resource) {
		return fmt.Sprintf("invalid arguments: resource not found")
	}
	file, err := os.Open(resource)
	if errors.Is(err, fs.ErrNotExist) {
		return fmt.Sprintf("invalid arguments: resource not found")
	} else if err != nil {
		return fmt.Sprintf("open: %s", err)
	}
	defer file.Close()
	finfo, err := file.Stat()
	if err != nil {
		return fmt.Sprintf("stat: %s", err)
	}
	if finfo.IsDir() {
		entries, err := file.ReadDir(0)
		if err != nil {
			return fmt.Sprintf("readdir: %s", err)
		}
		var content string
		i := offset
		if i > len(entries) {
			return fmt.Sprintf("[Read %d/%d entries]", i, len(entries))
		}
		j := min(offset+50, len(entries))
		for _, entry := range entries[i:j] {
			name := entry.Name()
			if entry.IsDir() {
				name += "/"
			}
			content += name + "\n"
		}
		content += fmt.Sprintf("[Read %d/%d entries]", j, len(entries))
		return content
	}
	if offset > finfo.Size() {
		return fmt.Sprintf("[Read %d/%d bytes]", offset, finfo.Size())
	}
	head := make([]byte, min(512, finfo.Size()))
	if _, err := io.ReadFull(file, head); err != nil {
		return fmt.Sprintf("read: %s", err)
	}
	mediaType := http.DetectContentType(head)
	var content []byte
	if mimetype.EqualsAny(mediaType, "text/plain", "application/pdf", "image/jpeg", "image/png", "image/webp") {
		if finfo.Size() > 512 {
			content = make([]byte, finfo.Size())
			copy(content, head)
			if _, err := io.ReadFull(file, content[512:]); err != nil {
				return fmt.Sprintf("read: %s", err)
			}
		} else {
			content = head[:finfo.Size()]
		}
		if mimeType.EqualsAny(mediaType, "text/plain") {
			return text(content, offset)
		} else if mimetype.EqualsAny(mediaType, "application/pdf") {
			return pdf(content, offset)
		} else if mimetype.EqualsAny(mediaType, "image/jpeg", "image/png", "image/webp") {
			return image(content, mediaType)
		}
	} else {
		return "invalid arguments: resource format not supported"
	}
}

func (r *Read) text(content []byte, offset int64) any {
	return string(content[offset:]) + fmt.Sprintf("\n[Read %d/%d bytes]", offset, len(content))
}

func (r *Read) pdf(content []byte, offset int64) any {
	doc, err := fits.NewFromMemory(content)
	if err != nil {
		return fmt.Sprintf("parse document: %s", doc)
	}
	defer doc.Close()
	if offset > doc.NumPage() {
		return fmt.Sprintf("[Read %d/%d pages]", offset, doc.NumPage())
	}
	textContent, err := doc.Text(offset)
	if err != nil {
		return fmt.Sprintf("extract PDF text: %s", err)
	}
	imageContent, err := doc.ImagePNG(offset, 300.0)
	if err != nil {
		return fmt.Sprintf("extract PDF image: %s", err)
	}
	resObj := make([]map[string]any, 2)
	resObj[0] = map[string]any{
		"type": "text",
		"text": fmt.Sprintf("%s\n[Read %d/%d pages]", imageContent, offset, doc.NumPage()),
	}
	resObj[1] = map[string]any{
		"type": "image_url",
		"image_url": map[string]any{
			"url": openrouter.ImageToURL(openrouter.Image{"image/png", imageContent}),
		},
	}
	return resObj
}

